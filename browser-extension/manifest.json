{
  "manifest_version": 3,
  "name": "Chess Stealth Zero-DOM",
  "version": "2.5.0",
  "description": "Zero-DOM bridge for Windows Stealth Overlay with WDA_EXCLUDEFROMCAPTURE.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.chess.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/*",
        "*://chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "stockfish.js"
      ],
      "matches": [
        "*://*.chess.com/*",
        "*://chess.com/*"
      ]
    }
  ]
}